{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worktrail.semantic.dogfood-manifest.v1",
  "title": "Worktrail table-hardening dogfood manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_commit",
    "worktrail_binary_sha256",
    "projects",
    "queries"
  ],
  "properties": {
    "schema": {
      "const": "worktrail.semantic.dogfood-manifest.v1"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "worktrail_binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "root",
          "root_digest",
          "source_content_digest",
          "rebuild_actions"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "root": {
            "type": "string",
            "minLength": 2
          },
          "root_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rebuild_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "scope"],
              "properties": {
                "action": {
                  "const": "semantic_rebuild"
                },
                "scope": {
                  "enum": ["all", "project", "user"]
                }
              }
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opaque_id",
          "text",
          "mode",
          "scope",
          "project_alias",
          "expect"
        ],
        "properties": {
          "opaque_id": {
            "type": "string",
            "pattern": "^q-[a-z0-9-]{2,64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["auto", "required"]
          },
          "scope": {
            "enum": ["all", "project", "user"]
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "project_alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "entry_id"],
            "properties": {
              "scope": {
                "enum": ["project", "user"]
              },
              "entry_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_role": {
                "enum": ["match", "neighbor"]
              },
              "start_byte": {
                "type": "integer",
                "minimum": 0
              },
              "end_byte": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
